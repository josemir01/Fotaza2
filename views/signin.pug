extends layout.pug

block content
  .container.mt-5
    .row.justify-content-center
      .col-md-6
        .card.shadow
          .card-body
            h2.text-center.mb-4 Registro de Usuario

            if error
              .alert.alert-danger= error

            form(action="/registro" method="POST")

              .mb-3
                label.form-label(for="fullName") Nombre completo
                input#fullName.form-control(
                  type="text"
                  name="fullName"
                  placeholder="Ingrese su nombre"
                  required
                )

              .mb-3
                label.form-label(for="email") Email
                input#email.form-control(
                  type="email"
                  name="email"
                  placeholder="Ingrese su email"
                  required
                )

              .mb-3
                label.form-label(for="birthDate") Fecha de nacimiento
                input#birthDate.form-control(
                  type="date"
                  name="birthDate"
                )

              .mb-3
                label.form-label(for="password") Contraseña
                input#password.form-control(
                  type="password"
                  name="password"
                  placeholder="Ingrese su contraseña"
                  required
                )

              .mb-3
                label.form-label(for="confirmPassword") Confirmar contraseña
                input#confirmPassword.form-control(
                  type="password"
                  name="confirmPassword"
                  placeholder="Repita su contraseña"
                  required
                )

              button.btn.btn-primary.w-100(type="submit")
                | Registrarse

            .text-center.mt-3
              p
                | ¿Ya tienes cuenta? 
                a(href="/login") Iniciar sesión
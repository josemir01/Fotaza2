extends layout.pug


block content
  .container.mt-4
    h2 Publicaciones

    if posts && posts.length
      each post in posts
        .card.mb-3
          .card-body

            h5= post.title
            p= post.description

            if post.Images && post.Images.length
              each img in post.Images
                img.img-fluid.rounded(
                  src=img.image,
                  style="max-width:300px"
                )
            if post.Hashtags && post.Hashtags.length
              .mt-2 
              each tag in post.Hashtags
                span.badge.bg-primary.me-2 #{tag.name} 
          .mt-1 
            a.btn.btn-primary.mt-2(
              href=`/post/${post.postid}`
            ) Ver publicación

    else
      p No hay publicaciones todavía




extends layout.pug
title publicaciones
block content
  .container.mt-4
    h2 Publicaciones

    if posts && posts.length
      each post in posts
        .card.mb-3
          .card-body
            h5= post.title
            p= post.description

            if post.Images && post.Images.length
              each img in post.Images
                img.img-fluid.rounded(src=img.image, style="max-width:300px")
    else
      p No hay publicaciones todavía



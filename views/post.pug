extends layout.pug

block content

    .container.mt-4
        h2= titulo || 'Publicaciones'

        // Buscadores
        .card.shadow-sm.mb-4
            .card-body

                ul.nav.nav-pills.mb-3

                    li.nav-item
                        button.nav-link.active(
                            type="button"
                            data-bs-toggle="pill"
                            data-bs-target="#buscarTitulo"
                        )
                            i.bi.bi-search.me-2
                            | Por título

                    li.nav-item
                        button.nav-link(
                            type="button"
                            data-bs-toggle="pill"
                            data-bs-target="#buscarUsuario"
                        )
                            i.bi.bi-person.me-2
                            | Por usuario

                    li.nav-item
                        button.nav-link(
                            type="button"
                            data-bs-toggle="pill"
                            data-bs-target="#buscarHashtag"
                        )
                            i.bi.bi-hash.me-2
                            | Por hashtag

                .tab-content

                    // Buscar por título
                    #buscarTitulo.tab-pane.fade.show.active

                        form(action="/post/buscar-texto" method="GET")
                            .input-group

                                input.form-control(
                                    type="search"
                                    name="termino"
                                    placeholder="Buscar por título..."
                                    required
                                )

                                button.btn.btn-primary(type="submit")
                                    i.bi.bi-search.me-2
                                    | Buscar

                    // Buscar por usuario
                    #buscarUsuario.tab-pane.fade

                        form(action="/usuario/buscar" method="GET")
                            .input-group

                                input.form-control(
                                    type="search"
                                    name="termino"
                                    placeholder="Buscar por nombre de usuario..."
                                    required
                                )

                                button.btn.btn-primary(type="submit")
                                    i.bi.bi-search.me-2
                                    | Buscar

                    // Buscar por hashtag
                    #buscarHashtag.tab-pane.fade

                        form(action="/post/buscar" method="GET")
                            .input-group

                                input.form-control(
                                    type="search"
                                    name="hashtag"
                                    placeholder="Buscar por hashtag..."
                                    required
                                )

                                button.btn.btn-primary(type="submit")
                                    i.bi.bi-search.me-2
                                    | Buscar

                .mt-3
                    a.text-decoration-none.text-muted(href="/post")
                        i.bi.bi-arrow-counterclockwise.me-1
                        | Limpiar búsqueda

        if msg
            .alert.alert-warning.mt-3
                = msg

        if posts && posts.length
            each post in posts
                .card.mb-3
                    .card-body
                        .d-flex.align-items-center.justify-content-between.mb-2
                            div
                                strong Publicado por:
                                a.ms-1(
                                    href=`/usuario/${post.User.userid}`
                                )
                                    = post.User.fullName

                            // Botón Seguir / Dejar de seguir
                            if user && user.userid !== post.idUser
                                if usuariosSeguidos && usuariosSeguidos.includes(post.idUser)
                                    form(
                                        action=`/usuario/${post.idUser}/dejarDeseguir`
                                        method="POST"
                                    )
                                        button.btn.btn-sm.btn-danger(type="submit")
                                            | Dejar de seguir
                                else
                                    form(
                                        action=`/usuario/${post.idUser}/seguir`
                                        method="POST"
                                    )
                                        button.btn.btn-sm.btn-primary(type="submit")
                                            | Seguir

                        h5= post.title
                        p= post.description

                        if post.Images && post.Images.length
                            .carousel.slide(id=`carouselPost${post.postid}`)
                                .carousel-inner
                                    each img, index in post.Images
                                        .carousel-item(class=index === 0 ? 'active' : '')
                                            img.d-block.w-100.rounded(
                                                src=img.image,
                                                style="height:400px; object-fit:contain; background:#000;"
                                            )

                                if post.Images.length > 1
                                    button.carousel-control-prev(
                                        type="button"
                                        data-bs-target=`#carouselPost${post.postid}`
                                        data-bs-slide="prev"
                                    )
                                        span.carousel-control-prev-icon

                                    button.carousel-control-next(
                                        type="button"
                                        data-bs-target=`#carouselPost${post.postid}`
                                        data-bs-slide="next"
                                    )
                                        span.carousel-control-next-icon

                        if post.Hashtags && post.Hashtags.length
                            .mt-2
                                each tag in post.Hashtags
                                    span.badge.bg-primary.me-2
                                        | #{tag.name}

                        .mt-1
                            a.btn.btn-primary.mt-2(
                                href=`/post/${post.postid}`
                            )
                                | Ver publicación
        else
            p No hay publicaciones todavía

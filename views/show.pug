
extends layout.pug 

block content

    .container.mt-4

        h2= post.title

        if post.description
            p= post.description

        if post.Images && post.Images.length
            each img in post.Images
                .card.mb-4
                    .card-body
                        img.img-fluid.rounded.mb-3(src=img.image, style="max-width:300px")

                        h4.mt-3 Valoración promedio

                        if img.promedioRating && img.promedioRating > 0
                            p ⭐ #{img.promedioRating} / 5
                        else
                            p Todavía no hay valoraciones

                        h4 Comentarios

                        if img.Comments && img.Comments.length
                            each comment in img.Comments
                                .card.mb-2
                                    .card-body

                                        if comment.User
                                            strong= comment.User.fullName

                                        p.mb-2= comment.content

                                        if user && user.userid === comment.idUser

                                            form(
                                                action=`/post/${post.postid}/imagen/${img.imageid}/comentario/${comment.Commentid}/editar`
                                                method="POST"
                                            )
                                                textarea.form-control.mb-2(
                                                    name="content"
                                                    rows="2"
                                                    required
                                                )= comment.content

                                                button.btn.btn-warning.btn-sm.me-2(type="submit")
                                                    | Guardar cambios

                                            form(
                                                action=`/post/${post.postid}/imagen/${img.imageid}/comentario/${comment.Commentid}/eliminar`
                                                method="POST"
                                            )
                                                button.btn.btn-danger.btn-sm(
                                                    type="submit"
                                                    onclick="return confirm('¿Deseás eliminar este comentario?')"
                                                )
                                                    | Eliminar

                        else
                            p No hay comentarios

                        form(action=`/post/${post.postid}/imagen/${img.imageid}/comentar`, method="POST")
                            textarea.form-control.mb-2(
                                name="content"
                                rows="2"
                                placeholder="Escribí un comentario..."
                            )

                            button.btn.btn-primary(type="submit")
                                | Comentar

                        h4.mt-4 Valorar imagen

                        form(action=`/post/${post.postid}/imagen/${img.imageid}/rating`, method="POST")
                            select.form-select(name="value")
                                option(value="") --seleccionar valoración--
                                option(value="1") 1 ⭐
                                option(value="2") 2 ⭐⭐
                                option(value="3") 3 ⭐⭐⭐
                                option(value="4") 4 ⭐⭐⭐⭐
                                option(value="5") 5 ⭐⭐⭐⭐⭐

                            button.btn.btn-warning.mt-2(type="submit")
                                | Valorar

        else
            p Esta publicación no tiene imágenes
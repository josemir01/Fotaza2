
extends layout.pug

block content

    .container.mt-4

        h2= post.title

        if post.description
            p= post.description

        // EDITAR, ELIMINAR Y VER DENUNCIAS
        if user && user.userid === post.idUser

            if tieneDenuncias
                .alert.alert-warning.mt-3
                    strong Publicacion bloqueada
                    p.mb-0 Esta publicacion tiene denuncias pendientes y no puede ser modificada.

            .d-flex.flex-wrap.gap-2.mb-3
                if !tieneDenuncias
                    a.btn.btn-warning(
                        href=`/post/${post.postid}/editar`
                    )
                        | Editar publicacion

                // ELIMINAR PUBLICACION
                if !tieneDenuncias && post.estadoPublicacion === 'activa'
                    form(
                        action=`/post/${post.postid}/eliminar`
                        method="POST"
                        onsubmit="return confirm('¿Estás seguro de eliminar esta publicación?')"
                    )
                        button.btn.btn-danger(type="submit")
                            | Eliminar publicación

                a.btn.btn-outline-danger(
                    href=`/denuncias/publicacion/${post.postid}/comentarios`
                )
                    | Ver denuncias de comentarios

        if post.Images && post.Images.length
            each img in post.Images
                .card.mb-4
                    .card-body
                        img.img-fluid.rounded.mb-3(
                            src=img.image
                            style="max-width:300px"
                        )

                        h4.mt-3 Valoracion promedio

                        if img.promedioRating && img.promedioRating > 0
                            p ⭐ #{img.promedioRating} / 5
                        else
                            p Todavia no hay valoraciones

                        // DENUNCIAR IMAGEN
                        if user && user.userid !== post.idUser
                            details.mb-3
                                summary.text-danger.small
                                    | Denunciar imagen

                                form.mt-3(
                                    action=`/denuncias/imagen/${img.imageid}`
                                    method="POST"
                                )
                                    select.form-select.mb-2(
                                        name="reason"
                                        required
                                    )
                                        option(value="") -- Seleccionar motivo --
                                        option(value="Contenido inapropiado") Contenido inapropiado
                                        option(value="Violencia") Violencia
                                        option(value="Spam") Spam
                                        option(value="Copyright") Infraccion de copyright
                                        option(value="Otro") Otro

                                    textarea.form-control.mb-2(
                                        name="description"
                                        rows="3"
                                        placeholder="Explique el motivo de la denuncia..."
                                        required
                                    )

                                    button.btn.btn-danger.btn-sm(type="submit")
                                        | Enviar denuncia

                        h4 Comentarios

                        if img.Comments && img.Comments.length
                            each comment in img.Comments
                                .card.mb-2
                                    .card-body
                                        if comment.User
                                            strong= comment.User.fullName

                                        p.mb-2= comment.content

                                        // EDITAR Y ELIMINAR COMENTARIO
                                        if user && user.userid === comment.idUser
                                            form(
                                                action=`/post/${post.postid}/imagen/${img.imageid}/comentario/${comment.Commentid}/editar`
                                                method="POST"
                                            )
                                                textarea.form-control.mb-2(
                                                    name="content"
                                                    rows="2"
                                                    required
                                                )= comment.content

                                                .d-flex.gap-2
                                                    button.btn.btn-warning.btn-sm(
                                                        type="submit"
                                                    )
                                                        | Guardar cambios

                                                    button.btn.btn-danger.btn-sm(
                                                        type="submit"
                                                        formaction=`/post/${post.postid}/imagen/${img.imageid}/comentario/${comment.Commentid}/eliminar`
                                                        formmethod="POST"
                                                        onclick="return confirm('¿Deseás eliminar este comentario?')"
                                                    )
                                                        | Eliminar

                                        // DENUNCIAR COMENTARIO
                                        if user && user.userid !== comment.idUser
                                            details.mt-2
                                                summary.text-danger.small
                                                    | Denunciar comentario

                                                form.mt-2(
                                                    action=`/denuncias/comentario/${comment.Commentid}`
                                                    method="POST"
                                                )
                                                    select.form-select.mb-2(
                                                        name="reason"
                                                        required
                                                    )
                                                        option(value="") -- Seleccionar motivo --
                                                        option(value="Spam") Spam
                                                        option(value="Ofensivo") Contenido ofensivo
                                                        option(value="Acoso") Acoso
                                                        option(value="Otro") Otro

                                                    textarea.form-control.mb-2(
                                                        name="description"
                                                        rows="2"
                                                        placeholder="Explique el motivo..."
                                                        required
                                                    )

                                                    button.btn.btn-danger.btn-sm(
                                                        type="submit"
                                                    )
                                                        | Enviar denuncia

                        else
                            p No hay comentarios

                        // ABRIR Y CERRAR COMENTARIOS
                        if user && user.userid === post.idUser
                            form(
                                action=`/post/${post.postid}/imagen/${img.imageid}/comentarios`
                                method="POST"
                            )
                                if img.comentDisable
                                    button.btn.btn-success.btn-sm.mb-3(
                                        type="submit"
                                    )
                                        | Abrir comentarios
                                else
                                    button.btn.btn-secondary.btn-sm.mb-3(
                                        type="submit"
                                    )
                                        | Cerrar comentarios

                        if img.comentDisable
                            .alert.alert-secondary
                                | Los comentarios estan cerrados para esta imagen
                        else
                            form(
                                action=`/post/${post.postid}/imagen/${img.imageid}/comentar`
                                method="POST"
                            )
                                textarea.form-control.mb-2(
                                    name="content"
                                    rows="2"
                                    placeholder="Escribí un comentario..."
                                    required
                                )

                                button.btn.btn-primary(type="submit")
                                    | Comentar

                        h4.mt-4 Valorar imagen

                        form(
                            action=`/post/${post.postid}/imagen/${img.imageid}/rating`
                            method="POST"
                        )
                            select.form-select(name="value")
                                option(value="") --seleccionar valoracion--
                                option(value="1") 1 ⭐
                                option(value="2") 2 ⭐⭐
                                option(value="3") 3 ⭐⭐⭐
                                option(value="4") 4 ⭐⭐⭐⭐
                                option(value="5") 5 ⭐⭐⭐⭐⭐

                            button.btn.btn-warning.mt-2(type="submit")
                                | Valorar

        else
            p Esta publicación no tiene imagen

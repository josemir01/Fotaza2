
extends layout.pug

block content

    .container.mt-4

        h2= post.title

        if post.description
            p= post.description

        // GUARDAR PUBLICACIÓN EN COLECCIÓN
        if user
            .card.mb-4
                .card-body
                    h5 Guardar en colección

                    if collections && collections.length
                        form(
                            action=`/colecciones/guardar/${post.postid}`
                            method="POST"
                        )
                            select.form-select.mb-2(
                                name="idCollection"
                                required
                            )
                                option(value="") -- Seleccionar colección --

                                each collection in collections
                                    option(value=collection.id)= collection.name

                            button.btn.btn-primary(type="submit")
                                | Guardar publicación

                    else
                        p.text-muted Todavía no creaste ninguna colección.

                        a.btn.btn-outline-primary(
                            href="/colecciones"
                        )
                            | Crear colección

        // EDITAR, ELIMINAR Y VER DENUNCIAS
        if user && user.userid === post.idUser

            if tieneDenuncias
                .alert.alert-warning.mt-3
                    strong Publicación bloqueada
                    p.mb-0 Esta publicación tiene denuncias pendientes y no puede ser modificada.

            .d-flex.flex-wrap.gap-2.mb-3

                if !tieneDenuncias
                    a.btn.btn-warning(
                        href=`/post/${post.postid}/editar`
                    )
                        | Editar publicación

                // ELIMINAR PUBLICACIÓN
                if !tieneDenuncias && post.estadoPublicacion === 'activa'
                    form(
                        action=`/post/${post.postid}/eliminar`
                        method="POST"
                        onsubmit="return confirm('¿Estás seguro de eliminar esta publicación?')"
                    )
                        button.btn.btn-danger(type="submit")
                            | Eliminar publicación

                a.btn.btn-outline-danger(
                    href=`/denuncias/publicacion/${post.postid}/comentarios`
                )
                    | Ver denuncias de comentarios

        // IMÁGENES DE LA PUBLICACIÓN
        if post.Images && post.Images.length

            each img in post.Images

                .card.mb-4
                    .card-body

                        img.img-fluid.rounded.mb-3(
                            src=img.image
                            style="max-width:300px"
                        )

                        // PROMEDIO Y CANTIDAD DE VALORACIONES
                        h4.mt-3 Valoración promedio

                        if img.cantidadRatings > 0
                            p.mb-1 ⭐ #{img.promedioRating} / 5
                            p.text-muted
                                | Cantidad de valoraciones: #{img.cantidadRatings}
                        else
                            p.mb-1 Todavía no hay valoraciones
                            p.text-muted
                                | Cantidad de valoraciones: 0

                        // DENUNCIAR IMAGEN
                        if user && user.userid !== post.idUser

                            details.mb-3
                                summary.text-danger.small
                                    | Denunciar imagen

                                form.mt-3(
                                    action=`/denuncias/imagen/${img.imageid}`
                                    method="POST"
                                )
                                    select.form-select.mb-2(
                                        name="reason"
                                        required
                                    )
                                        option(value="") -- Seleccionar motivo --
                                        option(value="Contenido inapropiado") Contenido inapropiado
                                        option(value="Violencia") Violencia
                                        option(value="Spam") Spam
                                        option(value="Copyright") Infracción de copyright
                                        option(value="Otro") Otro

                                    textarea.form-control.mb-2(
                                        name="description"
                                        rows="3"
                                        placeholder="Explique el motivo de la denuncia..."
                                        required
                                    )

                                    button.btn.btn-danger.btn-sm(type="submit")
                                        | Enviar denuncia

                        // COMENTARIOS
                        h4 Comentarios

                        if img.Comments && img.Comments.length

                            each comment in img.Comments

                                .card.mb-2
                                    .card-body

                                        if comment.User
                                            strong= comment.User.fullName

                                        p.mb-2= comment.content

                                        // EDITAR Y ELIMINAR COMENTARIO
                                        if user && user.userid === comment.idUser

                                            form(
                                                action=`/post/${post.postid}/imagen/${img.imageid}/comentario/${comment.Commentid}/editar`
                                                method="POST"
                                            )
                                                textarea.form-control.mb-2(
                                                    name="content"
                                                    rows="2"
                                                    required
                                                )= comment.content

                                                .d-flex.gap-2

                                                    button.btn.btn-warning.btn-sm(
                                                        type="submit"
                                                    )
                                                        | Guardar cambios

                                                    button.btn.btn-danger.btn-sm(
                                                        type="submit"
                                                        formaction=`/post/${post.postid}/imagen/${img.imageid}/comentario/${comment.Commentid}/eliminar`
                                                        formmethod="POST"
                                                        onclick="return confirm('¿Deseás eliminar este comentario?')"
                                                    )
                                                        | Eliminar

                                        // DENUNCIAR COMENTARIO
                                        if user && user.userid !== comment.idUser

                                            details.mt-2
                                                summary.text-danger.small
                                                    | Denunciar comentario

                                                form.mt-2(
                                                    action=`/denuncias/comentario/${comment.Commentid}`
                                                    method="POST"
                                                )
                                                    select.form-select.mb-2(
                                                        name="reason"
                                                        required
                                                    )
                                                        option(value="") -- Seleccionar motivo --
                                                        option(value="Spam") Spam
                                                        option(value="Ofensivo") Contenido ofensivo
                                                        option(value="Acoso") Acoso
                                                        option(value="Otro") Otro

                                                    textarea.form-control.mb-2(
                                                        name="description"
                                                        rows="2"
                                                        placeholder="Explique el motivo..."
                                                        required
                                                    )

                                                    button.btn.btn-danger.btn-sm(type="submit")
                                                        | Enviar denuncia

                        else
                            p No hay comentarios

                        // ABRIR Y CERRAR COMENTARIOS
                        if user && user.userid === post.idUser

                            form(
                                action=`/post/${post.postid}/imagen/${img.imageid}/comentarios`
                                method="POST"
                            )
                                if img.comentDisable

                                    button.btn.btn-success.btn-sm.mb-3(
                                        type="submit"
                                    )
                                        | Abrir comentarios

                                else

                                    button.btn.btn-secondary.btn-sm.mb-3(
                                        type="submit"
                                    )
                                        | Cerrar comentarios

                        // FORMULARIO DE COMENTARIOS
                        if img.comentDisable

                            .alert.alert-secondary
                                | Los comentarios están cerrados para esta imagen

                        else if user

                            form(
                                action=`/post/${post.postid}/imagen/${img.imageid}/comentar`
                                method="POST"
                            )
                                textarea.form-control.mb-2(
                                    name="content"
                                    rows="2"
                                    placeholder="Escribí un comentario..."
                                    required
                                )

                                button.btn.btn-primary(type="submit")
                                    | Comentar

                        else
                            p.text-muted
                                | Iniciá sesión para comentar esta imagen.

                        // VALORAR IMAGEN
                        h4.mt-4 Valorar imagen

                        if !user

                            p.text-muted
                                | Iniciá sesión para valorar esta imagen.

                        else if user.userid === post.idUser

                            p.text-muted
                                | No podés valorar tus propias imágenes.

                        else if img.yaValoro

                            .alert.alert-success
                                | Ya valoraste esta imagen.

                        else

                            form(
                                action=`/post/${post.postid}/imagen/${img.imageid}/rating`
                                method="POST"
                            )
                                select.form-select(
                                    name="value"
                                    required
                                )
                                    option(value="") -- Seleccionar valoración --
                                    option(value="1") 1 ⭐
                                    option(value="2") 2 ⭐⭐
                                    option(value="3") 3 ⭐⭐⭐
                                    option(value="4") 4 ⭐⭐⭐⭐
                                    option(value="5") 5 ⭐⭐⭐⭐⭐

                                button.btn.btn-warning.mt-2(
                                    type="submit"
                                )
                                    | Valorar

        else
            p Esta publicación no tiene imágenes

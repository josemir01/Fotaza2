extends layout.pug

block metadata
  title Crear publicación

block content
  .row.justify-content-center
    .col-md-7
      .card.shadow
        .card-body
          h2.mb-4 Crear nueva publicación

          if error
            .alert.alert-danger= error

          form(action="/post/crear", method="POST")
            .mb-3
              label.form-label(for="titulo") Titulo
              input#titulo.form-control(
                type="text",
                name="titulo",
              )

            .mb-3
              label.form-label(for="descripcion") Descripcion (opcional)
              textarea#descripcion.form-control(
                name="descripcion",
                rows="3",
              )

            .mb-3
              label.form-label(for="imagenes") Imagenes
              input#imagenes.form-control(
                type="file",
                name="imagenes",
                accept="image/*",
                multiple,
              )

            .mb-3
              label.form-label(for="nuevosHashtags") Hashtags (opcional)
              input#nuevosHashtags.form-control(
                type="text",
                name="nuevosHashtags",
                placeholder="Ej: musica, guitarra, rock",
              )
              small.text-muted Separá los hashtags con comas.


extends layout.pug

block content
    .container.mt-4
        h2 Buscar publicaciones

        // Búsqueda por hashtag
        form(action="/post/buscar" method="GET")
            select.form-select(name="hashtagId")
                option(value="") -- Buscar por hashtag --
                if allTags && allTags.length
                    each tag in allTags
                        option(value=tag.hashtagid)= tag.name

            button.btn.btn-primary.mt-2(type="submit") Buscar

        // Búsqueda por texto
        form(action="/post/buscar-texto" method="GET" class="mt-4")
            input.form-control(
                type="text"
                name="termino"
                placeholder="Buscar por título..."
            )
            button.btn.btn-primary.mt-2(type="submit") Buscar

        hr.mt-4

        h2 Buscar usuarios

        // Búsqueda por nombre
        form(action="/usuario/buscar" method="GET")
            input.form-control(
                type="text"
                name="termino"
                placeholder="Buscar usuario por nombre..."
            )
            button.btn.btn-primary.mt-2(type="submit") Buscar

extends layout.pug

block content
  form(action="/post/buscar" method="GET")
    select.form-select(name="hashtagId")
      option(value="") -- Buscar por hashtag --
      each tag in allTags
        option(value=tag.hashtagid)= tag.name
    button.btn.btn-primary.mt-2(type="submit") Buscar

        h2 Buscar publicaciones
    // Busqueda por texto
    form(action="/post/buscar-texto" method="GET" class="mb-4")
        input.form-control(
            type="text"
            name="termino"
            placeholder="Buscar por título o descripción..."
        )
        button.btn.btn-primary.mt-2(type="submit") Buscar
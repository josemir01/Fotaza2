doctype html 
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title Fotaza
    block metadata

    // Bootstrap CSS
    link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css")

    // Bootstrap Icons (opcional)
    link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css")

  body.bg-light

    // Navbar
    nav.navbar.navbar-expand-lg.navbar-dark.bg-dark.shadow-sm
      .container
        a.navbar-brand.fw-bold(href="/home") Fotaza

        .d-flex.gap-3.text-white
          a.text-white.text-decoration-none(href="/home") Inicio
          //a.text-white.text-decoration-none(href="/buscar") Buscar
          form(action="/post/buscar-texto", method="GET" class="d-flex ms-3")
            input.form-control.me-2(type="search", name="termino", placeholder="¿Qué buscas?")
            button.btn.btn-outline-light(type="submit") Buscar
          a.text-white.text-decoration-none(href="/post") Publicaciones
          a.text-white.text-decoration-none(href="/post/crear") Crear Publicaciones    
          
          if user
              a.text-white.text-decoration-none(href="/profile") Perfil
              a.text-white.text-decoration-none(href="/logout") Cerrar sesion
          else
              a.text-white.text-decoration-none(href="/login") Iniciar sesion
          a.text-white.text-decoration-none(href="/notificaciones")
            i.bi.bi-bell

    // Contenido dinámico
    .container.mt-4
      block content

    // Bootstrap JS
    script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js")
extends layout.pug

block content
    .container.mt-4

        h2 Iniciar sesión

        if error
            .alert.alert-danger
                = error

        form(action="/login" method="POST")
            .mb-3
                label.form-label Email
                input.form-control(
                    type="email"
                    name="email"
                    required
                )

            .mb-3
                label.form-label Contraseña
                input.form-control(
                    type="password"
                    name="password"
                    required
                )

            button.btn.btn-primary(type="submit")
                | Iniciar sesión
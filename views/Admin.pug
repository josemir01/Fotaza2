
extends layout.pug

block content

    .container.mt-4

        h2.mb-4 Panel de administración

        // PUBLICACIONES PENDIENTES

        h4.mb-3 Publicaciones pendientes de revisión

        if posts && posts.length

            each post in posts

                .card.mb-4
                    .card-body

                        h5.card-title= post.title

                        if post.User
                            p.mb-1
                                strong Autor:
                                |  #{post.User.fullName}

                        if post.description
                            p= post.description

                        if post.Images && post.Images.length

                            each img in post.Images

                                .border.rounded.p-3.mb-3

                                    img.img-fluid.rounded.mb-3(
                                        src=img.image
                                        style="max-width:250px"
                                    )

                                    if img.ImageReports && img.ImageReports.length

                                        p.text-danger
                                            strong Denuncias pendientes:
                                            |  #{img.ImageReports.length}

                                        each report in img.ImageReports

                                            .alert.alert-warning

                                                p.mb-1
                                                    strong Motivo:
                                                    |  #{report.reason}

                                                p.mb-0
                                                    strong Descripción:
                                                    |  #{report.description}

                                    else
                                        p.text-muted
                                            | Esta imagen no tiene denuncias pendientes.

                        // ACCIONES DEL ADMINISTRADOR

                        .d-flex.flex-wrap.gap-2.mt-3

                            a.btn.btn-primary(
                                href=`/post/${post.postid}`
                            )
                                | Ver publicación

                            // APROBAR PUBLICACIÓN

                            form(
                                action=`/admin/${post.postid}/aprobar`
                                method="POST"
                                onsubmit="return confirm('¿Aprobar esta publicación y desestimar sus denuncias?')"
                            )
                                button.btn.btn-success(
                                    type="submit"
                                )
                                    | Aprobar publicación

                            // BLOQUEAR PUBLICACIÓN

                            form(
                                action=`/admin/${post.postid}/bloquear`
                                method="POST"
                                onsubmit="return confirm('¿Estás seguro de bloquear esta publicación?')"
                            )
                                button.btn.btn-danger(
                                    type="submit"
                                )
                                    | Bloquear publicación

        else

            .alert.alert-success
                | No hay publicaciones pendientes de revisión.


        // PUBLICACIONES BLOQUEADAS

        hr.my-5

        h4.mb-3 Publicaciones bloqueadas

        if blockedPosts && blockedPosts.length

            each post in blockedPosts

                .card.mb-4
                    .card-body

                        h5.card-title= post.title

                        span.badge.bg-danger.mb-3
                            | Bloqueada

                        if post.User
                            p.mb-1
                                strong Autor:
                                |  #{post.User.fullName}

                        if post.description
                            p= post.description

                        if post.Images && post.Images.length

                            each img in post.Images

                                .border.rounded.p-3.mb-3

                                    img.img-fluid.rounded(
                                        src=img.image
                                        style="max-width:250px"
                                    )

                        // RESTAURAR PUBLICACIÓN

                        .d-flex.gap-2.mt-3

                            form(
                                action=`/admin/${post.postid}/restaurar`
                                method="POST"
                                onsubmit="return confirm('¿Restaurar esta publicación?')"
                            )
                                button.btn.btn-success(
                                    type="submit"
                                )
                                    | Restaurar publicación

        else

            .alert.alert-secondary
                | No hay publicaciones bloqueadas.

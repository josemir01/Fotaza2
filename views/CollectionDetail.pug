extends layout.pug

block content

    .container.mt-4

        if esPropietario
            a.btn.btn-outline-secondary.mb-3(
                href="/colecciones"
            )
                | Volver a mis colecciones
        else
            a.btn.btn-outline-secondary.mb-3(
                href=`/usuario/${collection.idUser}`
            )
                | Volver al perfil

        h2= collection.name

        if collection.description
            p.text-muted= collection.description

        if collection.isPrivate
            span.badge.bg-secondary.mb-3 Privada
        else
            span.badge.bg-success.mb-3 Pública

        hr

        h4 Publicaciones guardadas

        if collection.Posts && collection.Posts.length

            .row
                each post in collection.Posts

                    .col-md-4.mb-4
                        .card.h-100

                            if post.Images && post.Images.length
                                img.card-img-top(
                                    src=post.Images[0].image
                                    style="height:200px; object-fit:cover;"
                                )

                            .card-body
                                h5.card-title= post.title

                                if post.description
                                    p.card-text= post.description

                                .d-flex.flex-wrap.gap-2

                                    a.btn.btn-primary(
                                        href=`/post/${post.postid}`
                                    )
                                        | Ver publicación

                                    // SOLO EL PROPIETARIO PUEDE QUITAR
                                    if esPropietario
                                        form(
                                            action=`/colecciones/${collection.id}/quitar/${post.postid}`
                                            method="POST"
                                            onsubmit="return confirm('¿Querés quitar esta publicación de la colección?')"
                                        )
                                            button.btn.btn-danger(type="submit")
                                                | Quitar de colección

        else
            p.text-muted Esta colección todavía no contiene publicaciones.